# AgriSense Smart Agriculture Weather Monitoring
# Environment Configuration

# Optional: Default Location Override
# VITE_DEFAULT_LATITUDE=30.9010
# VITE_DEFAULT_LONGITUDE=75.8573
# VITE_DEFAULT_CITY=Ludhiana

# Open-Meteo operates without an API key for open research and agricultural use.
# If you have an Open-Meteo Commercial API key, specify it here:
# VITE_OPEN_METEO_API_KEY=your_commercial_key_here

# IoT ESP32 Telemetry Module Webhook (Module 2)
# VITE_ESP32_WEBHOOK_URL=http://localhost:5000/api/v1/telemetry/esp32
